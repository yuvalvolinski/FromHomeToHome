<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FromHomeToHome.Mobile.Views.LoginPage"
             Title="כניסה למשחק"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- Background image with dark overlay -->
        <Image Source="mainwallp.png" Aspect="AspectFill" />
        <BoxView BackgroundColor="#0F172A" Opacity="0.85" />

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Spacing="16" Padding="30">

                <!-- Title -->
                <Label Text="ברוכים הבאים"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <Label Text="התחבר לחשבון שלך"
                       FontSize="14"
                       TextColor="#94A3B8"
                       HorizontalOptions="Center"
                       Margin="0,0,0,15" />

                <!-- Email field -->
                <Border Stroke="#334155" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 12" Padding="12,0">
                    <Entry Placeholder="דואר אלקטרוני"
                           Keyboard="Email"
                           PlaceholderColor="#64748B"
                           TextColor="White"
                           Text="{Binding Email}" />
                </Border>

                <!-- Password field -->
                <Border Stroke="#334155" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 12" Padding="12,0">
                    <Entry Placeholder="סיסמה"
                           IsPassword="True"
                           PlaceholderColor="#64748B"
                           TextColor="White"
                           Text="{Binding Password}" />
                </Border>

                <!-- Error message -->
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#EF4444"
                       FontSize="13"
                       HorizontalOptions="Center"
                       IsVisible="{Binding HasError}" />

                <!-- Loading indicator -->
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="#38BDF8"
                                   HorizontalOptions="Center" />

                <!-- Login button -->
                <Button Text="התחבר"
                        Command="{Binding LoginCommand}"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="#2563EB"
                        CornerRadius="25"
                        HeightRequest="52"
                        Margin="0,10,0,0" />

                <!-- Register link -->
                <Button Text="אין לך חשבון? הירשם כאן"
                        Clicked="OnRegisterClicked"
                        FontSize="13"
                        TextColor="#38BDF8"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Margin="0,10,0,0" />

                <!-- Back button -->
                <Button Text="חזרה"
                        Clicked="OnBackClicked"
                        FontSize="13"
                        TextColor="#CBD5E1"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
