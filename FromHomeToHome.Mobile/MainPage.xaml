<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FromHomeToHome.Mobile.Views.MainPage"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        
        <!--תמונת רקע-->
        
        <Image Source="mainwallp.png"  
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <!-- שכבת הכהיה עדינה מעל התמונה לשיפור קריאות הטקסט (Overlay) -->
        <BoxView BackgroundColor="Black" Opacity="0.4" />

        <!-- התוכן המרכזי -->
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Fill"
                             Spacing="20"
                             Padding="40">

            <!-- כותרת המשחק -->
            <Label Text="From home to Home"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0, 0, 0, 50">
                <Label.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.7"/>
                </Label.Shadow>
            </Label>

            <!-- כפתור כניסה (בולט, גדול ובעל נוכחות) -->
            <Button x:Name="BtnLogin"
                    Text="כניסה"
                    Command="{Binding GoToLoginCommand}"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#2563EB"
                    CornerRadius="30"
                    HeightRequest="60"
                    HorizontalOptions="Fill">
                <Button.Shadow>
                    <Shadow Brush="#2563EB" Offset="0,4" Radius="10" Opacity="0.4"/>
                </Button.Shadow>
            </Button>

            <!-- כפתור רישום (קטן יותר, שקוף עם מסגרת עדינה) -->
            <Button x:Name="BtnSignUp"
                    Text="רישום משתמש חדש"
                    Command="{Binding GoToRegisterCommand}"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#E2E8F0"
                    BackgroundColor="Transparent"
                    BorderColor="#94A3B8"
                    BorderWidth="1.5"
                    CornerRadius="25"
                    HeightRequest="50"
                    HorizontalOptions="Fill"
                    Margin="0, 10, 0, 0" />

       

        </VerticalStackLayout>
    </Grid>
</ContentPage>