<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FromHomeToHome.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FromHomeToHome.Mobile"
    Title="FromHomeToHome.Mobile">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:Views.MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Register"
        ContentTemplate="{DataTemplate local:Views.RegisterPage}"
        Route="RegisterPage" />

</Shell>
