<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FromHomeToHome.Mobile.Views.GamePage"
             Title="GamePage"
             FlowDirection="RightToLeft"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="24,28,24,32" Spacing="20">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                    <Border WidthRequest="58"
                            HeightRequest="58"
                            BackgroundColor="#F8FAFC"
                            Stroke="#CBD5E1"
                            StrokeThickness="1.5"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="29" />
                        </Border.StrokeShape>
                        <Label Text="{Binding UserInitial}"
                               TextColor="#0F172A"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                        <Label Text="Lets go to journey"
                               TextColor="#64748B"
                               FontSize="14"
                               CharacterSpacing="0.4" />
                        <Label Text="{Binding WelcomeMessage}"
                               TextColor="#0F172A"
                               FontSize="26"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Border Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="14,10"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="התנתק"
                               TextColor="#DC2626"
                               FontSize="13"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Label Text="🚪"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="22"
                    Margin="0,6,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="22">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Ready for your next challenge?"
                                   TextColor="#64748B"
                                   FontSize="15" />
                            <Label Text="בחר מסלול, צבור נקודות ופתח שלבים חדשים בדרך הביתה."
                                   TextColor="#0F172A"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                BackgroundColor="White"
                                Stroke="#BFDBFE"
                                StrokeThickness="1.5"
                                Padding="14,10"
                                VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="LEVEL"
                                       TextColor="#2563EB"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding CurrentLevelText}"
                                       TextColor="#0F172A"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="18,16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border WidthRequest="50"
                                    HeightRequest="50"
                                    BackgroundColor="#EFF6FF"
                                    Stroke="#BFDBFE"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="25" />
                                </Border.StrokeShape>
                                <Label Text="🏆"
                                       FontSize="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="הניקוד המצטבר שלך"
                                       TextColor="#64748B"
                                       FontSize="13" />
                                <Label Text="{Binding TotalScore, StringFormat='{0:N0} נק׳'}"
                                       TextColor="#2563EB"
                                       FontSize="26"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Journey"
                                       TextColor="#64748B"
                                       FontSize="13" />
                                <Label Text="עבור בין שלבים וצבע את המפה שלך"
                                       TextColor="#0F172A"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Rewards"
                                       TextColor="#64748B"
                                       FontSize="13" />
                                <Label Text="פתח בונוסים ככל שתתקדם במשחק"
                                       TextColor="#0F172A"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Button Text="Play"
                            Clicked="OnPlayClicked"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="22"
                            CornerRadius="22"
                            HeightRequest="62"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12" Margin="0,10,0,0">
                <Border BackgroundColor="#16A34A" Stroke="#16A34A" StrokeThickness="1" Padding="10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="⎋" FontSize="18" TextColor="White" HorizontalOptions="Center" />
                        <Label Text="Exit" TextColor="White" FontSize="12" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="#16A34A" Stroke="#16A34A" StrokeThickness="1" Padding="10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="★" FontSize="18" TextColor="White" HorizontalOptions="Center" />
                        <Label Text="Records" TextColor="White" FontSize="12" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" BackgroundColor="#16A34A" Stroke="#16A34A" StrokeThickness="1" Padding="10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="⚙" FontSize="18" TextColor="White" HorizontalOptions="Center" />
                        <Label Text="Settings" TextColor="White" FontSize="12" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="3" BackgroundColor="#16A34A" Stroke="#16A34A" StrokeThickness="1" Padding="10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="☺" FontSize="18" TextColor="White" HorizontalOptions="Center" />
                        <Label Text="Profile" TextColor="White" FontSize="12" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
